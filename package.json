{
  "name": "smart-page-translator",
  "displayName": "Smart Page Translator",
  "description": "Translate text in editor from English to Chinese",
  "version": "0.2.9",
  "publisher": "843773493",
  "icon": "asset/icon.png",
  "homepage": "https://github.com/843773493/smartpagetranslator",
  "keywords": [
    "vscode",
    "translator",
    "translation",
    "bing",
    "chinese"
  ],
  "author": "843773493",
  "repository": {
    "type": "git",
    "url": "https://github.com/843773493/smartpagetranslator.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:smart-page-translator-notes",
    "onView:smart-page-translator-root-files",
    "onCommand:smartPageTranslator.translate",
    "onCommand:smartPageTranslator.extractAstOutline",
    "onCommand:smartPageTranslator.runWithTsx",
    "onCommand:smartPageTranslator.runPytest",
    "onCommand:smartPageTranslator.rootFiles.refresh",
    "onCommand:smartPageTranslator.rootFiles.open",
    "onCommand:smartPageTranslator.rootFiles.newFile",
    "onCommand:smartPageTranslator.rootFiles.newFolder",
    "onCommand:smartPageTranslator.rootFiles.rename",
    "onCommand:smartPageTranslator.rootFiles.delete",
    "onCommand:smartPageTranslator.rootFiles.copy",
    "onCommand:smartPageTranslator.rootFiles.cut",
    "onCommand:smartPageTranslator.rootFiles.paste",
    "onCommand:smartPageTranslator.rootFiles.copyPath",
    "onCommand:smartPageTranslator.rootFiles.revealInOS"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smartPageTranslator.translate",
        "title": "Translate to Chinese",
        "icon": "$(file-text)"
      },
      {
        "command": "smartPageTranslator.extractAstOutline",
        "title": "复制代码结构上下文",
        "category": "Smart Page Translator"
      },
      {
        "command": "smartPageTranslator.runWithTsx",
        "title": "用tsx运行",
        "category": "Smart Page Translator"
      },
      {
        "command": "smartPageTranslator.runPytest",
        "title": "pytest运行",
        "category": "Smart Page Translator"
      },
      {
        "command": "smartPageTranslator.rootFiles.refresh",
        "title": "刷新根目录文件树",
        "category": "根目录文件树",
        "icon": "$(refresh)"
      },
      {
        "command": "smartPageTranslator.rootFiles.open",
        "title": "打开",
        "category": "根目录文件树",
        "icon": "$(go-to-file)"
      },
      {
        "command": "smartPageTranslator.rootFiles.newFile",
        "title": "新建文件",
        "category": "根目录文件树",
        "icon": "$(new-file)"
      },
      {
        "command": "smartPageTranslator.rootFiles.newFolder",
        "title": "新建文件夹",
        "category": "根目录文件树",
        "icon": "$(new-folder)"
      },
      {
        "command": "smartPageTranslator.rootFiles.rename",
        "title": "重命名",
        "category": "根目录文件树",
        "icon": "$(edit)"
      },
      {
        "command": "smartPageTranslator.rootFiles.delete",
        "title": "删除",
        "category": "根目录文件树",
        "icon": "$(trash)"
      },
      {
        "command": "smartPageTranslator.rootFiles.copy",
        "title": "复制",
        "category": "根目录文件树",
        "icon": "$(copy)"
      },
      {
        "command": "smartPageTranslator.rootFiles.cut",
        "title": "剪切",
        "category": "根目录文件树",
        "icon": "$(cut)"
      },
      {
        "command": "smartPageTranslator.rootFiles.paste",
        "title": "粘贴",
        "category": "根目录文件树",
        "icon": "$(clippy)"
      },
      {
        "command": "smartPageTranslator.rootFiles.copyPath",
        "title": "复制路径",
        "category": "根目录文件树",
        "icon": "$(copy)"
      },
      {
        "command": "smartPageTranslator.rootFiles.revealInOS",
        "title": "在系统中显示",
        "category": "根目录文件树",
        "icon": "$(folder-opened)"
      },
      {
        "command": "smartPageTranslator.notes.deleteNote",
        "title": "删除笔记",
        "icon": {
          "light": "asset/resources/light/delete.svg",
          "dark": "asset/resources/dark/delete.svg"
        }
      },
      {
        "command": "smartPageTranslator.notes.deleteFolder",
        "title": "删除文件夹",
        "icon": {
          "light": "asset/resources/light/delete.svg",
          "dark": "asset/resources/dark/delete.svg"
        }
      },
      {
        "command": "smartPageTranslator.notes.listNotes",
        "title": "列出笔记",
        "category": "笔记"
      },
      {
        "command": "smartPageTranslator.notes.newNote",
        "title": "新建笔记",
        "category": "笔记",
        "icon": "$(new-file)"
      },
      {
        "command": "smartPageTranslator.notes.newFolder",
        "title": "新建文件夹",
        "category": "笔记",
        "icon": "$(new-folder)"
      },
      {
        "command": "smartPageTranslator.notes.openNote",
        "title": "打开笔记",
        "icon": {
          "light": "asset/resources/light/note.svg",
          "dark": "asset/resources/dark/note.svg"
        }
      },
      {
        "command": "smartPageTranslator.notes.refreshNotes",
        "title": "刷新笔记",
        "category": "笔记",
        "icon": "$(refresh)"
      },
      {
        "command": "smartPageTranslator.notes.renameNote",
        "title": "重命名笔记",
        "icon": {
          "light": "asset/resources/light/rename.svg",
          "dark": "asset/resources/dark/rename.svg"
        }
      },
      {
        "command": "smartPageTranslator.notes.renameFolder",
        "title": "重命名文件夹",
        "icon": {
          "light": "asset/resources/light/rename.svg",
          "dark": "asset/resources/dark/rename.svg"
        }
      },
      {
        "command": "smartPageTranslator.notes.setupNotes",
        "title": "设置笔记位置",
        "category": "笔记",
        "icon": "$(gear)"
      }
    ],
    "submenus": [
      {
        "id": "smart.run",
        "label": "Run"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "smart-page-translator-notes",
          "title": "Notes",
          "icon": "asset/resources/notes-light.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "smart-page-translator-root-files",
          "name": "根目录文件树"
        }
      ],
      "smart-page-translator-notes": [
        {
          "id": "notes",
          "name": "Notes"
        }
      ]
    },
    "menus": {
      "editor/title/context": [
        {
          "submenu": "smart.run",
          "group": "Python",
          "when": "resourceExtname =~ /\\.(ts|tsx|js|jsx|mts|cts|mjs|cjs|py)$/"
        }
      ],
      "editor/context": [
        {
          "submenu": "smart.run",
          "group": "Python",
          "when": "editorTextFocus && resourceExtname =~ /\\.(ts|tsx|js|jsx|mts|cts|mjs|cjs|py)$/"
        }
      ],
      "smart.run": [
        {
          "command": "smartPageTranslator.runWithTsx",
          "group": "Python",
          "when": "resourceExtname =~ /\\.(ts|tsx|js|jsx|mts|cts|mjs|cjs)$/"
        },
        {
          "command": "smartPageTranslator.runPytest",
          "group": "Python",
          "when": "resourceLangId == python && !virtualWorkspace && shellExecutionSupported"
        }
      ],
      "editor/context/copy": [
        {
          "command": "smartPageTranslator.extractAstOutline",
          "when": "editorTextFocus && resourceExtname =~ /\\.(js|jsx|mjs|cjs|ts|tsx|py)$/"
        }
      ],
      "explorer/context": [
        {
          "command": "smartPageTranslator.notes.newNote",
          "group": "notes@1",
          "when": "view == notes"
        },
        {
          "command": "smartPageTranslator.notes.newFolder",
          "group": "notes@2",
          "when": "view == notes"
        },
        {
          "command": "smartPageTranslator.notes.refreshNotes",
          "group": "notes@3",
          "when": "view == notes"
        },
        {
          "command": "smartPageTranslator.notes.setupNotes",
          "group": "notes@4",
          "when": "view == notes"
        }
      ],
      "view/title": [
        {
          "command": "smartPageTranslator.rootFiles.refresh",
          "when": "view == smart-page-translator-root-files",
          "group": "navigation@1"
        },
        {
          "command": "smartPageTranslator.notes.newNote",
          "when": "view == notes",
          "group": "navigation@1"
        },
        {
          "command": "smartPageTranslator.notes.newFolder",
          "when": "view == notes",
          "group": "navigation@2"
        },
        {
          "command": "smartPageTranslator.notes.refreshNotes",
          "when": "view == notes",
          "group": "navigation@3"
        },
        {
          "command": "smartPageTranslator.notes.setupNotes",
          "when": "view == notes",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "smartPageTranslator.rootFiles.open",
          "when": "view == smart-page-translator-root-files && viewItem == rootFilesFile",
          "group": "0_open@1"
        },
        {
          "command": "smartPageTranslator.rootFiles.newFile",
          "when": "view == smart-page-translator-root-files && (viewItem == rootFilesRoot || viewItem == rootFilesFolder)",
          "group": "1_new@1"
        },
        {
          "command": "smartPageTranslator.rootFiles.newFolder",
          "when": "view == smart-page-translator-root-files && (viewItem == rootFilesRoot || viewItem == rootFilesFolder)",
          "group": "1_new@2"
        },
        {
          "command": "smartPageTranslator.rootFiles.rename",
          "when": "view == smart-page-translator-root-files && (viewItem == rootFilesFile || viewItem == rootFilesFolder)",
          "group": "2_modification@1"
        },
        {
          "command": "smartPageTranslator.rootFiles.delete",
          "when": "view == smart-page-translator-root-files && (viewItem == rootFilesFile || viewItem == rootFilesFolder)",
          "group": "2_modification@2"
        },
        {
          "command": "smartPageTranslator.rootFiles.copy",
          "when": "view == smart-page-translator-root-files && (viewItem == rootFilesFile || viewItem == rootFilesFolder)",
          "group": "3_clipboard@1"
        },
        {
          "command": "smartPageTranslator.rootFiles.cut",
          "when": "view == smart-page-translator-root-files && (viewItem == rootFilesFile || viewItem == rootFilesFolder)",
          "group": "3_clipboard@2"
        },
        {
          "command": "smartPageTranslator.rootFiles.paste",
          "when": "view == smart-page-translator-root-files && (viewItem == rootFilesRoot || viewItem == rootFilesFolder)",
          "group": "3_clipboard@3"
        },
        {
          "command": "smartPageTranslator.rootFiles.copyPath",
          "when": "view == smart-page-translator-root-files && (viewItem == rootFilesRoot || viewItem == rootFilesFolder || viewItem == rootFilesFile)",
          "group": "4_workspace@1"
        },
        {
          "command": "smartPageTranslator.rootFiles.revealInOS",
          "when": "view == smart-page-translator-root-files && (viewItem == rootFilesRoot || viewItem == rootFilesFolder || viewItem == rootFilesFile)",
          "group": "4_workspace@2"
        },
        {
          "command": "smartPageTranslator.rootFiles.refresh",
          "when": "view == smart-page-translator-root-files && (viewItem == rootFilesRoot || viewItem == rootFilesFolder)",
          "group": "4_workspace@3"
        },
        {
          "command": "smartPageTranslator.notes.renameNote",
          "when": "view == notes && viewItem == note",
          "group": "1_modification@1"
        },
        {
          "command": "smartPageTranslator.notes.deleteNote",
          "when": "view == notes && viewItem == note",
          "group": "1_modification@2"
        },
        {
          "command": "smartPageTranslator.notes.openNote",
          "when": "view == notes && viewItem == note",
          "group": "2_workspace@1"
        },
        {
          "command": "smartPageTranslator.notes.renameFolder",
          "when": "view == notes && viewItem == folder",
          "group": "1_modification@1"
        },
        {
          "command": "smartPageTranslator.notes.deleteFolder",
          "when": "view == notes && viewItem == folder",
          "group": "1_modification@2"
        },
        {
          "command": "smartPageTranslator.notes.openNote",
          "when": "view == notes && viewItem == folder",
          "group": "2_workspace@1"
        },
        {
          "command": "smartPageTranslator.notes.newNote",
          "when": "view == notes && viewItem == folder",
          "group": "2_workspace@2"
        },
        {
          "command": "smartPageTranslator.notes.newNote",
          "when": "view == notes && !viewItem",
          "group": "navigation@1"
        },
        {
          "command": "smartPageTranslator.notes.newFolder",
          "when": "view == notes && !viewItem",
          "group": "navigation@2"
        },
        {
          "command": "smartPageTranslator.notes.refreshNotes",
          "when": "view == notes && !viewItem",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "smartPageTranslator.translate",
          "group": "navigation",
          "title": "Translate to Chinese (Create zh-CN file)"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Smart Page Translator",
      "properties": {
        "smartPageTranslator.concurrency": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Maximum number of concurrent chunk translations."
        },
        "smartPageTranslator.maxChunk": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "maximum": 10000,
          "description": "Maximum chunk length (in characters) when splitting text for translation. Default is 1000."
        },
        "smartPageTranslator.notes.notesLocation": {
          "type": "string",
          "default": "",
          "description": "笔记存储位置路径"
        },
        "smartPageTranslator.notes.notesExtensions": {
          "type": "string",
          "default": "md",
          "description": "笔记文件扩展名，多个用逗号分隔"
        },
        "smartPageTranslator.notes.notesDefaultNoteExtension": {
          "type": "string",
          "default": "md",
          "description": "新建笔记的默认扩展名"
        }
      }
    },
    "keybindings": [
      {
        "command": "smartPageTranslator.notes.listNotes",
        "key": "alt+l",
        "mac": "alt+l"
      },
      {
        "command": "smartPageTranslator.notes.newNote",
        "key": "alt+n",
        "mac": "alt+n"
      },
      {
        "command": "smartPageTranslator.rootFiles.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == smart-page-translator-root-files"
      },
      {
        "command": "smartPageTranslator.rootFiles.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == smart-page-translator-root-files"
      },
      {
        "command": "smartPageTranslator.rootFiles.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == smart-page-translator-root-files"
      }
    ],
    "viewsWelcome": [
      {
        "view": "notes",
        "contents": "To get started, you need to select a location to store your notes.\n[Select Location](command:smartPageTranslator.notes.setupNotes)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "package": "npm run compile && node ./scripts/package-vsix.js",
    "publish:vsix": "node ./scripts/publish-vsix.js",
    "publish": "npm run publish:vsix",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run e2e",
    "start": "node scripts/open-dev-host.mjs",
    "open:dev": "node scripts/open-dev-host.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:trace": "node scripts/run-e2e.mjs trace",
    "e2e:debug": "node scripts/run-e2e.mjs debug",
    "artifacts:latest": "node scripts/inspect-latest-run.mjs",
    "clean": "node scripts/clean.mjs build",
    "clean:artifacts": "node scripts/clean.mjs artifacts",
    "clean:cache": "node scripts/clean.mjs cache",
    "clean:all": "node scripts/clean.mjs all"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^22.18.3",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@wdio/cli": "9.29.1",
    "@wdio/devtools-service": "10.6.1",
    "@wdio/globals": "9.29.1",
    "@wdio/json-reporter": "9.29.1",
    "@wdio/logger": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/protocols": "9.28.0",
    "@wdio/spec-reporter": "9.29.1",
    "eslint": "^8.56.0",
    "expect-webdriverio": "5.6.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vsce": "^2.10.0",
    "wdio-vscode-service": "8.0.0",
    "webdriverio": "9.29.1"
  },
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "bing-translate-api": "^3.0.1",
    "glob": "^11.0.0",
    "rimraf": "^6.0.0"
  },
  "files": [
    "out/**/*",
    "asset/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
